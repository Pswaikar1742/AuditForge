# AuditForge Environment Configuration
# Copy this file to .env and adjust as needed

# Database
AUDITFORGE_DB_PATH=auditforge.db

# Open-Weight AI (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Alternative verified lightweight models:
# OLLAMA_MODEL=llama3.2:latest
# OLLAMA_MODEL=qwen2.5-coder:7b-instruct
OLLAMA_TIMEOUT_SECONDS=30

# Sandbox (Docker)
DOCKER_IMAGE=auditforge-probe:latest
DOCKER_TIMEOUT_SECONDS=15
DOCKER_MEMORY_LIMIT=256m
DOCKER_CPU_QUOTA=50000
DOCKER_NETWORK_MODE=none

# API & Server
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=5173

# Logging & Telemetry
LOG_LEVEL=INFO
