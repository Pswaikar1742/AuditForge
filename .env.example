# AuditForge Environment Configuration
# Copy this file to .env and adjust as needed

# Database
# Default: SQLite standalone file (auditforge.db)
AUDITFORGE_DB_PATH=auditforge.db
# Production: PostgreSQL cluster connection
DATABASE_URL=postgresql://auditforge:auditforge@localhost:5432/auditforge

# Distributed Job Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Open-Weight AI & Inference Providers
# Providers: ollama | openai_compatible | disabled
AUDITFORGE_INFERENCE_PROVIDER=ollama
AUDITFORGE_INFERENCE_BASE_URL=http://localhost:8000/v1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Alternative verified lightweight models:
# OLLAMA_MODEL=llama3.2:latest
# OLLAMA_MODEL=qwen2.5-coder:7b-instruct
OLLAMA_TIMEOUT_SECONDS=30

# Sandbox (Docker)
DOCKER_IMAGE=auditforge-probe:latest
DOCKER_TIMEOUT_SECONDS=15
DOCKER_MEMORY_LIMIT=256m
DOCKER_CPU_QUOTA=50000
DOCKER_NETWORK_MODE=none

# API & Server
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=5173

# Logging & Telemetry
LOG_LEVEL=INFO

